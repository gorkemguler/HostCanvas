# Servers listen on all interfaces; application policy keeps LAN access disabled
# until it is explicitly enabled with authentication in the setup/settings UI.
TLS_SENTINEL_API_HOST=0.0.0.0
TLS_SENTINEL_API_PORT=8787
TLS_SENTINEL_WEB_HOST=0.0.0.0
TLS_SENTINEL_UI_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable only when the team intentionally needs to scan internal targets.
TLS_SENTINEL_ALLOW_PRIVATE_TARGETS=false

# Optional: enables public-DNS, DNSSEC, DMARC, and SPF rules.
# TLS_SENTINEL_PUBLIC_DNS_RESOLVER=1.1.1.1

# Passive subdomain discovery through crt.name. The apex domain is sent to the
# external service only when the user enables discovery in the asset form.
# Discovery is unchecked by default; it requires explicit consent per asset.
TLS_SENTINEL_CRT_NAME_ENABLED=true
TLS_SENTINEL_CRT_NAME_LIMIT=200

# Optional testssl.sh overrides.
TLS_SENTINEL_TESTSSL_PATH=testssl.sh
TLS_SENTINEL_TESTSSL_TIMEOUT_MS=240000
TLS_SENTINEL_MAX_CONCURRENT_SCANS=2

# Yalnızca API güvenilen bir reverse proxy arkasındaysa açın. Compose bunu açar
# ve Caddy X-Forwarded-For başlığını istemci IP'siyle kendisi yazar.
TLS_SENTINEL_TRUST_PROXY=false

# Docker Compose: set this to ONE hostname or IPv4 address used by LAN clients,
# without scheme, port, or path. Both Caddy certificates and API Host validation
# use it. Compose reads .env (or --env-file .env.local), not .env.local by default.
TLS_SENTINEL_HTTPS_HOST=localhost

# Webhook adreslerini şifrelemek için opsiyonel kalıcı anahtar. Boş bırakılırsa
# /data/.secret-key güvenli izinlerle otomatik üretilir. Yedeğiyle birlikte saklayın.
# TLS_SENTINEL_SECRET_KEY=replace-with-a-long-random-secret

# Optional browser API override, baked into the frontend build. Leave unset for
# automatic same-host discovery. HTTPS reverse proxy kullanımında API aynı origin'dedir.
# NEXT_PUBLIC_TLS_SENTINEL_API_URL=https://host-canvas.example.test:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000
